# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel > Project Settings > API). Nunca commite o .env.local.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a anon key antiga. Nunca use a service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mostra o botão "Continuar com Google". Só ligue depois de ativar o provider Google no painel do Supabase.
VITE_AUTH_GOOGLE_ENABLED=false
